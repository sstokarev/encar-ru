{
  "manifest_version": 3,
  "name": "Encar по-русски — цена под ключ в РФ",
  "version": "0.5.1",
  "description": "Показывает рядом с ценой на encar.com цену автомобиля под ключ в рублях и полный расчёт: пошлина, сборы, доставка.",
  "homepage_url": "https://sstokarev.github.io/encar-ru/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.encar.com/*"],
      "js": ["widget.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
